#
# Include the headers for symbols these files actually use. fbio.cpp names fd_set and picks <sys/select.h> up transitively; fbshell.cpp names TIOCCONS and picks <linux/vt.h> up transitively. Both work on glibc by accident of header ordering and neither does here. A translation unit that names a symbol should include the header that declares it.
#
# Generated with `git diff` against the pinned fbterm commit
# 419c6be55413a7069fbcc66883d58caa94ba3933. Regenerate with
# ports/fbterm/build.sh; never edit by hand.

diff --git a/src/fbio.cpp b/src/fbio.cpp
index e5afc44..794ed0a 100644
--- a/src/fbio.cpp
+++ b/src/fbio.cpp
@@ -30,6 +30,17 @@
 #define NR_EPOLL_FDS 10
 s32 epollFd;
 #else
+/*
+ * Samsara: config.h leaves HAVE_EPOLL undefined, so this is the select(2)
+ * path. It needs fd_set, and upstream never includes <sys/select.h> here --
+ * it relies on some other header in the chain dragging it in, which happens to
+ * work on glibc and does not happen on a libc that includes what it uses.
+ *
+ * Including it directly is the fix, and it is not a workaround: a translation
+ * unit that names fd_set has to include the header that defines it, rather than
+ * depending on which unrelated header happens to be included first.
+ */
+#include <sys/select.h>
 static fd_set fds;
 static u32 maxfd = 0;
 #endif
diff --git a/src/fbshell.cpp b/src/fbshell.cpp
index 653bb2d..0fd2312 100644
--- a/src/fbshell.cpp
+++ b/src/fbshell.cpp
@@ -27,6 +27,11 @@
 #include <fcntl.h>
 #include <sys/time.h>
 #include <sys/ioctl.h>
+/* For TIOCCONS, used in switchVt() below. Upstream never includes this and
+ * picks the constant up transitively; a translation unit that names a request
+ * number should include the header that declares it rather than depend on which
+ * unrelated header came first. */
+#include <linux/vt.h>
 #include "fbshell.h"
 #include "fbshellman.h"
 #include "fbconfig.h"
