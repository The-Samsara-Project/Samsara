CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_LN=y
CONFIG_READLINK=y
CONFIG_REALPATH=y
CONFIG_UNLINK=y
CONFIG_TOUCH=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CHGRP=y
CONFIG_CHROOT=y
CONFIG_STAT=y
CONFIG_DD=y
CONFIG_INSTALL=y
CONFIG_MKNOD=y
CONFIG_MKFIFO=y
CONFIG_MKTEMP=y
CONFIG_TRUNCATE=y
CONFIG_SHRED=y

CONFIG_ECHO=y
