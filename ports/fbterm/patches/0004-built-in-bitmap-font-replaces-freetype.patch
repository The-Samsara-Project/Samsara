+	Font::Glyph *g = (Font::Glyph *)malloc(sizeof(Font::Glyph) + GLYPH_W * GLYPH_H);
+	if (!g) return 0;
+
+	/* `pitch` is the stride from one row of the glyph to the next, in *bytes*,
+	 * not pixels and not rows. freetype's `bitmap.pitch` is the same quantity and
+	 * upstream assigns it straight from that, so whatever freetype's convention
+	 * is, this has to match it. The renderer walks the pixmap by it once per
+	 * row, so it is the distance between the first bytes of consecutive rows.
+	 */
+	g->pitch = GLYPH_W;
+	g->width = GLYPH_W;
+	g->height = GLYPH_H;
+	/* A fixed-width bitmap font has no left side bearing and sits at a fixed
+	 * height within the cell. Both are what make the cell a constant size,
+	 * which is what lets fbterm compute a character position arithmetically
+	 * instead of measuring. */
+	g->left = 0;
+	g->top = CELL_TOP;
+
+	/* Unpack the glyph, one output byte per pixel.
+	 *
+	 * This is not a copy and it is not a cosmetic change. The renderer reads
+	 * *one byte per pixel*, with three meanings: 0 is background, 0xff is
+	 * foreground, and anything between is a blend of the two at that fraction.
+	 * That is an antialiased 8-bit-per-pixel format, because that is what
+	 * freetype hands it. The font data is 1 bit per pixel -- eight pixels packed
+	 * into a byte, most significant bit leftmost.
+	 *
+	 * So handing the packed bytes over directly is a silent and total failure
+	 * rather than a partial one. Each of a row's 8 bytes is read as one *pixel*
+	 * lit at that byte's fraction of full, which turns a row of text into eight
+	 * vertical smears of grey and shifts every glyph out of shape. Nothing
+	 * reports it: the values are all in range, the cell is the right size, the
+	 * right number of pixels is written, and the terminal is visibly drawing.
+	 * The only symptom is a screen of what looks like static, which reads as a
+	 * broken font or a broken framebuffer and is neither.
+	 *
+	 * Hence the loop. A set bit becomes 0xff, a clear bit becomes 0, and nothing
+	 * in between is produced -- the font is 1-bit, so there is no coverage to
+	 * express and every pixel is either on or off.
+	 */
+	for (u32 row = 0; row < GLYPH_H; row++) {
+		u8 bits = ascii8x8[unicode - 0x20][row];
+		for (u32 col = 0; col < GLYPH_W; col++) {
+			/* Bit 0 is the leftmost pixel.
+			 *
+			 * The font data is a copy of Samsara's own console font
+			 * (user/nutcracker-rt/src/fb.rs, from kernel/src/console.rs), and
+			 * that font is stored least-significant-bit first: both of those
+			 * render a row by testing `1 << cx` with cx counting from the left
+			 * edge. freetype's bitmaps are the other way round, which is what
+			 * made MSB-first look like the natural choice here.
+			 *
+			 * Picking MSB-first mirrors every glyph horizontally. It is a
+			 * completely legible terminal and completely wrong text, which is
+			 * the worst of both: no error, no missing pixels, correct spacing,
+			 * and every character readable as itself. It is only visible on
+			 * asymmetric glyphs -- 'l', 'F', 'P', '2', 'S' -- where a human
+			 * notices immediately and a test that checks "is there ink" does
+			 * not. Hence the reference to the two renderers that already agree
+			 * on this data: a third renderer guessing the convention is how it
+			 * got wrong in the first place.
+			 */
+			g->pixmap[row * GLYPH_W + col] = (bits & (1 << col)) ? 0xff : 0x00;
+		}
+	}
+	return g;
 }
 
