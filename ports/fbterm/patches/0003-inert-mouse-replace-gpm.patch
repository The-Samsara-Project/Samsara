+/*
+ * Samsara port: an inert mouse, replacing the gpm(1) client.
+ *
+ * Upstream's mouse support is a client for the General Purpose Mouse daemon: it
+ * connects to gpm's Unix domain socket and decodes the motion and button
+ * reports gpm sends. fbterm has no evdev mouse path of its own, so there is no
+ * alternative in the upstream code to fall back to -- it either talks to gpm or
+ * it has no mouse.
+ *
+ * Samsara has no sockets, so this is inert. The interface is preserved so
+ * fbterm.cpp's three call sites compile and behave correctly without edits: the
+ * instance exists, so `Mouse::instance()` never returns null and fbterm's
+ * `if (Mouse::instance())` test passes, and switchVc() does nothing.
+ *
+ * The absence of a descriptor is the load-bearing part, exactly as in the
+ * input-method proxy stub. Mouse is an IoPipe, and the io dispatcher selects on
+ * every registered pipe's descriptor; a descriptor here that never becomes
+ * readable would sit in select() forever. setFd(-1) keeps the mouse out of the
+ * dispatcher entirely.
+ *
+ * What this costs, stated plainly: no mouse reporting in fbterm. The kernel's
+ * PS/2 mouse driver and /dev/input/event0 both work and both report motion and
+ * buttons -- they are simply not connected to fbterm yet. Wiring fbterm's
+ * mouse handling to evdev instead of gpm is real future work, not a config
+ * change, and it is the right way to spend it: it removes the gpm dependency
+ * rather than stubbing around it.
+ */
+
 #ifndef MOUSE_H
 #define MOUSE_H
-
 #include "io.h"
 #include "instance.h"
-
 class Mouse : public IoPipe {
 	DECLARE_INSTANCE(Mouse)
 public:
-	void switchVc(bool enter);
+	// No console to switch to and nothing to report, so this does nothing.
+	void switchVc(bool enter) { (void)enter; }
 private:
-	virtual void readyRead(s8 *buf, u32 len);
-
+	// Never called: there is no descriptor, so the io dispatcher never
+	// selects on this object.
+	virtual void readyRead(s8 *buf, u32 len) { (void)buf; (void)len; }
 	u16 x, y;
 };
-
 #endif
