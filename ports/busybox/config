CONFIG_EXPAND=y
CONFIG_UNEXPAND=y
CONFIG_FOLD=y
CONFIG_SPLIT=y
CONFIG_TAC=y
CONFIG_SEQ=y
CONFIG_TEST=y
CONFIG_EXPR=y
CONFIG_FACTOR=y
CONFIG_TIMEOUT=y
CONFIG_TSORT=y

CONFIG_CKSUM=y
CONFIG_CRC32=y
