+	// keymap. With no keymap there is nothing to be privileged for, and
+	// briefly running as uid 0 to do nothing is not a thing worth doing.
 }
 
 void TtyInput::readyRead(s8 *buf, u32 len)
 {
-	if (mRawMode) {
-		processRawKeys(buf, len);
-		return;
-	}
+	/*
+	 * No raw-mode branch here. Upstream diverts to processRawKeys() when
+	 * mRawMode is set; that decoder is gone on this port (see the note above
+	 * setRawMode) and setRawMode() never sets mRawMode, so the branch could
+	 * only ever be false.
+	 *
+	 * It is removed rather than left as a dead `if` because a surviving branch
