+/* Cached glyphs, one slot per codepoint in the font's range. A terminal redraws
+ * the same handful of characters constantly -- fbterm calls getGlyph once per
+ * character per frame -- so each glyph is built once and kept. This is what
+ * upstream's glyph cache did as well; what is gone is the freetype-rendered
+ * bitmap it was caching. */
+static Font::Glyph *glyphCache[128];
+
+/* Build one glyph. Glyph ends in a flexible array member, so the pixmap lives
+ * immediately after the header -- which is the entire reason it is one. */
+static Font::Glyph *makeGlyph(u32 unicode)
 {
