# `id`, `whoami` and `groups` all resolve the caller's name through the passwd
# database, which is why ports/mlibc carries the getpwnam/getpwuid sysdeps for
# this port. Without them these three are the only applets here that cannot run
# at all, and a shell with no `id` is a shell you cannot check anything with.
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_GROUPS=y

# ---------------------------------------------------------------------------
# find, grep, xargs.
#
# xargs earns its place for a specific reason rather than as part of the set: it
# is how a pipeline that produces names gets them into another command, and
# without it the only way to do that is a shell loop, which forks once per
# element.
# ---------------------------------------------------------------------------
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_EGREP=y
CONFIG_FGREP=y
CONFIG_XARGS=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_FEATURE_XARGS_SUPPORT_QUOTES=y
CONFIG_FEATURE_XARGS_SUPPORT_TERMOPT=y
CONFIG_FEATURE_XARGS_SUPPORT_ZERO_TERM=y
CONFIG_FEATURE_XARGS_SUPPORT_REPL_STR=y
CONFIG_FEATURE_XARGS_SUPPORT_ARGS_FILE=y

# find: the tests and actions a script actually reaches for. No -exec+ and no
# -printf, because both want machinery nothing else on this system uses.
CONFIG_FEATURE_FIND_PRINT0=y
CONFIG_FEATURE_FIND_MTIME=y
CONFIG_FEATURE_FIND_PERM=y
CONFIG_FEATURE_FIND_TYPE=y
CONFIG_FEATURE_FIND_EXECUTABLE=y
CONFIG_FEATURE_FIND_XDEV=y
CONFIG_FEATURE_FIND_MAXDEPTH=y
CONFIG_FEATURE_FIND_EXEC=y
CONFIG_FEATURE_FIND_EXEC_PLUS=y
CONFIG_FEATURE_FIND_EXEC_OK=y
CONFIG_FEATURE_FIND_USER=y
CONFIG_FEATURE_FIND_GROUP=y
CONFIG_FEATURE_FIND_NOT=y
CONFIG_FEATURE_FIND_DEPTH=y
CONFIG_FEATURE_FIND_PAREN=y
CONFIG_FEATURE_FIND_SIZE=y
CONFIG_FEATURE_FIND_PRUNE=y
CONFIG_FEATURE_FIND_QUIT=y
CONFIG_FEATURE_FIND_DELETE=y
CONFIG_FEATURE_FIND_EMPTY=y
CONFIG_FEATURE_FIND_PATH=y
CONFIG_FEATURE_FIND_REGEX=y
CONFIG_FEATURE_FIND_CONTEXT=y
CONFIG_FEATURE_FIND_LINKS=y

# ---------------------------------------------------------------------------
# Text processing.
#
# The three that transform a file, plus the two that compare one. sed and awk are
# here for the same reason the shell is: they are the tools a system with no
# compiler and no Python gets its text processing done with.
# ---------------------------------------------------------------------------
CONFIG_AWK=y
CONFIG_SED=y
CONFIG_CMP=y
CONFIG_DIFF=y
CONFIG_ED=y
CONFIG_PATCH=y
CONFIG_FEATURE_AWK_GNU_EXTENSIONS=y

# ---------------------------------------------------------------------------
# Archives and compression.
#
# gzip only, and tar to drive it. busybox also does bzip2, xz and lzma, and each
# would mean porting a decompressor to gain one applet; tar's transparent
# -Z handling covers the common case in the meantime.
# ---------------------------------------------------------------------------
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_UNCOMPRESS=y
CONFIG_TAR=y
CONFIG_CPIO=y
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_GZIP_DECOMPRESS=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_AUTODETECT=y
CONFIG_FEATURE_TAR_FROM=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_FEATURE_TAR_LONG_OPTIONS=y
CONFIG_FEATURE_TAR_TO_COMMAND=y
CONFIG_FEATURE_TAR_UNAME_GNAME=y
CONFIG_FEATURE_TAR_OLDSUN_COMPATIBILITY=y
CONFIG_FEATURE_TAR_OLDGNU_COMPATIBILITY=y

# ---------------------------------------------------------------------------
# Miscellaneous.
# ---------------------------------------------------------------------------
CONFIG_WHICH=y
CONFIG_CLEAR=y
CONFIG_KILL=y
CONFIG_WATCH=y
CONFIG_GETOPT=y
CONFIG_FEATURE_GETOPT_LONG=y
CONFIG_FLOCK=y
CONFIG_HEXDUMP=y
CONFIG_HD=y

# ---------------------------------------------------------------------------
# Features whose defaults are wrong for this system.
#
# Written out rather than left to the all-no base so that a future busybox which
# changes a default does not silently turn one of these on. Each is a default
# this port has no way to honour.
# ---------------------------------------------------------------------------

# ls. This is the one applet whose output people read most, and the defaults
# without these are not the defaults anyone has seen on another system. The
# grouping changed in 1.37 -- file types and the sort-direction flags are folded
# into FEATURE_LS_SORTFILES and FEATURE_LS_FILETYPES -- so the list is short
# because the options are.
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=y
CONFIG_FEATURE_LS_USERNAME=y
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_LS_RECURSIVE=y
CONFIG_FEATURE_LS_WIDTH=y
CONFIG_FEATURE_LS_FOLLOWLINKS=n

# stat: format string and filesystem reporting. The filesystem half is absent
# because there is no statfs to report; the rest is what makes `stat` able to
# print one field instead of all of them.
CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_FEATURE_STAT_FILESYSTEM=n

# du: 1K blocks, the unit a person means when they say "how big".
CONFIG_FEATURE_DU_DEFAULT_BLOCKSIZE_1K=y

# sort: -b, -f, -i, -n, -r, -o, -t, -u, -k, -V all become options rather than
# things busybox has to guess. OPTIMIZE_MEMORY is off because the largest sort
# on this system is a directory listing.
CONFIG_FEATURE_SORT_BIG=y
CONFIG_FEATURE_SORT_OPTIMIZE_MEMORY=n

# split: -b, -C, -n, and the suffix-length option.
CONFIG_FEATURE_SPLIT_FANCY=y

# cp: long options, so a script can be explicit instead of guessing which spelling
# this version takes. mv has no options of its own to expose.
CONFIG_FEATURE_CP_LONG_OPTIONS=y
CONFIG_FEATURE_CP_REFLINK=n
CONFIG_FEATURE_INSTALL_LONG_OPTIONS=y

# touch: the POSIX spelling of -d, which is what a script means by a timestamp
# rather than by a modification.
CONFIG_FEATURE_TOUCH_SUSV3=y

# tr: EQUIV makes [:upper:] and [:lower:] actually work, which the shell's
# builtins do not need but a script rewriting text does.
CONFIG_FEATURE_TR_CLASSES=y
CONFIG_FEATURE_TR_EQUIV=y

# test and $(( )): 64-bit, so a size or an offset computed by a script is not
# truncated at 2GiB.
CONFIG_FEATURE_TEST_64=y
CONFIG_EXPR_MATH_SUPPORT_64=y

# cat with -n, and tail that can follow a growing file.
CONFIG_FEATURE_CATN=y
CONFIG_FEATURE_CATV=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_FEATURE_TEE_USE_BLOCK_IO=y

# date: the ISO format and the compatibility date form. A script that writes a
# timestamp wants the first; a person wants the second.
CONFIG_FEATURE_DATE_ISOFMT=y
CONFIG_FEATURE_DATE_COMPAT=y
CONFIG_FEATURE_DATE_NANO=y

# diff: the directory form and long options.
CONFIG_FEATURE_DIFF_LONG_OPTIONS=y
CONFIG_FEATURE_DIFF_DIR=y

# checksums: the -c form, which turns a checksum file back into a yes or a no.
CONFIG_FEATURE_MD5_SHA1_SUM_CHECK=y

# od: the long-form output names, so `od -A d -t x1` works.
CONFIG_FEATURE_WC_LARGE=y

# There is no mount applet in this configuration, and the reason is worth stating
# precisely because it is not the one a reader would guess. The kernel has no
# mount syscall at all: no SYS_MOUNT, no SYS_UMOUNT, nothing in the table in
# kernel/src/abi/mod.rs. There is one filesystem, the root, and it is the root.
#
# So this is not a mount that cannot record to /etc/mtab, which is what
# include/platform.h's HAVE_MNTENT_H undef is about -- that header is still
# supplied by the port, with an always-empty table, because
# libbb/find_mount_point.c includes it unconditionally and because the callers
# of find_mount_point(3) deserve one honest answer rather than a deletion. The
# applet is absent because the operation it performs does not exist.
CONFIG_MOUNT=n
CONFIG_UMOUNT=n
CONFIG_MOUNTPOINT=n

# ---------------------------------------------------------------------------
# Explicitly off.
#
# These are defaults this port would otherwise inherit, and each one is a
# facility Samsara does not have. Written out so that a busybox that changes a
# default cannot turn one of them on behind a build that still succeeds.
# ---------------------------------------------------------------------------

# A second shell, and a second of the one we have.
CONFIG_HUSH=n
CONFIG_BASH_IS_ASH=n
CONFIG_BASH_IS_HUSH=n

# The suid machinery. See the note at the top of this file.
CONFIG_FEATURE_SUID=n
CONFIG_FEATURE_SUID_CONFIG=n
CONFIG_SELINUX=n

# busybox 1.37 offers no locale options at all, so there is nothing to turn off
# here. Worth saying rather than leaving a reader to go looking: the port's libc
# has no setlocale either, so every program agrees on byte order and message
# language, and no program is being denied a choice it could otherwise have used.
# A locale layer would be a large dependency bought for features this system does
# not expose.

# A second, interactive text editor, and the pager that would need ncurses.
CONFIG_VI=n
CONFIG_LESS=n
CONFIG_MORE=n
CONFIG_HEXEDIT=n

# Login accounting, and anything that reads it.
CONFIG_LOGIN=n
CONFIG_SU=n
CONFIG_SULOGIN=n

# Scheduling. One CPU, and a nice value nothing reads.
CONFIG_NICE=n
CONFIG_RENICE=n
CONFIG_IONICE=n
CONFIG_TASKSET=n

# Terminal multiplexers and the login programs that would want one.
CONFIG_SCRIPT=n
CONFIG_SCRIPTREPLAY=n
