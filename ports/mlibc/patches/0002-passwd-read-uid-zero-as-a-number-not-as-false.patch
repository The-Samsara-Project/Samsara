+		 * conversion, and uid 0 is root -- the one account a login prompt
+		 * must be able to resolve. The symptom is that
+		 * `getpwnam("root")` returns NULL, so every correct password is
+		 * refused with "Login incorrect", which points at the password
+		 * rather than at the parse that threw the entry away.
+		 */
 		auto uid = segments[2].to_number<int>();
-		if(!uid)
+		if(!uid.has_value())
 			return false;
