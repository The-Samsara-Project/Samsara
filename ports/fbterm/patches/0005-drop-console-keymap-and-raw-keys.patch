@@ -196,117 +177,51 @@ void TtyInput::readyRead(s8 *buf, u32 len)
 	if (shell && len > start) shell->keyInput(buf + start, len - start);
 }
 
-static u16 down_num;
-static bool key_down[NR_KEYS];
-static u8 shift_down[NR_SHIFT];
-static u16 shift_state;
+/*
+ * Samsara: the raw-key decoder and the console keymap state are gone.
+ *
+ * Everything from here to the end of the file existed to serve raw mode. Raw
+ * mode is entered on Linux by setting the console's keyboard mode to
+ * K_MEDIUMRAW, which makes the console deliver keycodes instead of characters;
+ * processRawKeys() then decoded those keycodes by consulting the kernel
+ * keymap -- shift tables, modifier tracking, and the fbterm shortcut range
+ * AC_START..AC_END -- to work out both ordinary text and fbterm's own
+ * shortcuts.
+ *
+ * None of it applies here, for the same reason setupSysKey() is gone: a Samsara
+ * pty delivers UTF-8 characters and there is no keycode layer above it. There
+ * is no keymap to consult, so the decoder would have nothing to decode with.
+ *
+ * The decisive point is that raw mode is never entered on this port even
+ * upstream's control flow: the sole caller is switchVc(), and it passes
+ * `false`. mRawMode is therefore always false, readyRead()'s raw branch is
+ * unreachable, and this whole block is dead code that would only compile if the
+ * console keymap interface were declared for a keymap that does not exist.
+ *
+ * Deleting it is therefore honest rather than a shortcut, and setRawMode() below
+ * says so where a reader will look.
+ */
 
