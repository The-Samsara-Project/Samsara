diff --git a/src/input.cpp b/src/input.cpp
index f1304a2..6088cbe 100644
--- a/src/input.cpp
+++ b/src/input.cpp
@@ -27,6 +27,7 @@
 #include <linux/kd.h>
 #include <linux/input.h>
 #include "input.h"
+#include "../fbconfig.h"
 #include "input_key.h"
 #include "fbshell.h"
 #include "fbshellman.h"
@@ -92,7 +93,25 @@ TtyInput *TtyInput::createInstance()
 
 TtyInput::TtyInput()
 {
-	setFd(dup(STDIN_FILENO));
+	/*
+	 * Samsara: when attaching to a terminal somebody else owns, the keyboard
+	 * is on that descriptor.
+	 *
+	 * Upstream reads the keyboard from stdin, because upstream made the pty:
+	 * the master it holds is stdin's other end, so reading stdin reads what
+	 * was typed. With --attach-fd the pty already exists and the program on
+	 * the other end holds the slave -- so stdin here is that same slave, and
+	 * fbterm competes with the program for every keystroke instead of
+	 * forwarding it. Two readers of one descriptor is not a terminal, it is a
+	 * race neither side wins, and what it looks like is a prompt where nothing
+	 * typed ever appears.
+	 *
+	 * The attached descriptor is the master: the end the keyboard writes to
+	 * and the end the program's output is read from, which is both of the
+	 * things this class wants, and neither is shared with the program.
+	 */
+	s32 attach = Config::instance()->getAttachFd();
+	setFd(attach >= 0 ? dup(attach) : dup(STDIN_FILENO));
 }
 
 TtyInput::~TtyInput()
@@ -121,6 +140,28 @@ void TtyInput::switchVc(bool enter)
 	tcgetattr(STDIN_FILENO, &oldTm);
 
 	ioctl(STDIN_FILENO, KDGKBMODE, &oldKbMode);
+
+	/*
+	 * Samsara: with --attach-fd the terminal belongs to the program on the
+	 * other end, so its settings are left alone.
+	 *
+	 * Upstream makes the pty, which makes it the owner: it configures the
+	 * terminal for its own child and the child is expected to cope. Attached
+	 * to somebody else's pty it is a guest, and reconfiguring it fights the
+	 * program for it. The cost is not a rendering artefact: TCSAFLUSH throws
+	 * away whatever has not been read yet, so the password a person had
+	 * already typed was discarded the moment fbterm decided the terminal was
+	 * in the wrong mode, and the next prompt read the line after it instead.
+	 * A correct password was then compared against the following one, and
+	 * every login failed with "Login incorrect".
+	 *
+	 * The program manages the terminal's settings, which is what a login
+	 * program does: it has to turn echo off for the password and on again
+	 * afterwards, and nothing else is in a position to do it.
+	 */
+	if (Config::instance()->getAttachFd() >= 0)
+		return;
+
 	setRawMode(false, true);
 
 	termios tm = oldTm;
