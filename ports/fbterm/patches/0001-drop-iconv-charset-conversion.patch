-		mCodecRead = 0;
-	}
-
-	if (mCodecWrite) {
-		iconv_close((iconv_t)mCodecWrite);
-		mCodecWrite = 0;
-	}
-
+	// Nothing to do: both directions already agree, and the null-codec
+	// pass-through is exactly the right behaviour.
 	if (!strcasecmp(up, down)) return;
 
-	mCodecRead = iconv_open(up, down);
-	if (mCodecRead == (void*)-1) mCodecRead = 0;
+	if (codecIsUtf8(up) && codecIsUtf8(down)) return;
 
-	mCodecWrite = iconv_open(down, up);
-	if (mCodecWrite == (void*)-1) mCodecWrite = 0;
+	// A real conversion was asked for and cannot be provided. Leave the
+	// descriptors null (pass-through) and say so, so the user is not left
+	// staring at mis-rendered text wondering why.
+	fprintf(stderr, "[io] charset conversion %s <-> %s is unavailable; "
+			"treating both ends as UTF-8\n", up, down);
 }
 
