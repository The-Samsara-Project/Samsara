#
# busybox configuration for the Samsara port.
#
# This file is data, not a build product. ports/busybox/build.sh runs
# `make allnoconfig` to get a config with everything off, merges this file onto
# it with toolchain/merge-config, and then runs `oldconfig` so kconfig resolves
# the dependencies and reports any symbol in here that does not exist. Nothing
# here mentions a path, which is what keeps the file portable: the same config
# describes the same program on any machine.
#
# The selection rule was: a shell, and the programs needed to actually use one.
# The omissions are grouped by reason, because the reason is the useful part --
# each of these is a capability the kernel does not have yet, so the applet would
# not be a reduced version of itself but a program that fails when used.
#
#   Anything that reads /proc: ps, free, uptime, top, pmap, smemcap. There is no
#   procfs. These are not "ps without columns", they are programs whose only
#   source of data does not exist, and they would print an empty list rather
#   than admit they cannot answer.
#
#   Anything that reads a utmp file: who, users, last. Same shape of gap: the
#   kernel has no login accounting to record or to read.
#
#   Anything that needs statfs: df. The VFS has no per-filesystem statistics, so
#   there is nothing for it to report and a fabricated number would be worse
#   than no number. This is also why include/platform.h drops
#   HAVE_SYS_STATFS_H for this port.
#
#   Anything that opens a socket: the entire networking menu. There are no
#   sockets in the kernel, so these are not a reduced telnet but a program that
#   cannot be started.
#
#   Anything that opens a terminal the fancy way: vi, less, more, hexedit. vi and
#   less are ncurses clients, and ncurses is a library the size of the shell it
#   would serve. ed is here instead, which is small and does the job.
#
#   Anything that is a daemon or an init: there is no supervision to attach to
#   and nothing that wants to be pid 1. The kernel spawns the first program
#   directly and hands the framebuffer to a terminal.
#
#   setuid applets. CONFIG_INSTALL_APPLET_SYMLINKS is off and FEATURE_SUID is
#   off for the same reason the list is short: the port has one user, so a
#   privileged helper would be a way to run a program as root rather than a tool.

# ---------------------------------------------------------------------------
# Link and install shape.
# ---------------------------------------------------------------------------
CONFIG_STATIC=y
CONFIG_LFS=y

# Build one binary and let argv[0] choose the applet: /bin/ls, /bin/cat and the
# rest are all the same image, reached by name.
#
# Both settings below are about *reaching* that image. Upstream defaults
# BUSYBOX_EXEC_PATH to /proc/self/exe, and this port has no procfs, so an applet
# that shells out to another applet -- `find -exec`, `xargs`, the shell's own
# `exec` -- has no way to find itself and would fail. Naming the real path is the
# whole fix, and it is why the path appears here rather than being patched in.
#
# FEATURE_PREFER_APPLETS makes those same callers try the applet table before
# consulting PATH, so they keep working even where a link is missing. It is
# redundant once every applet has a link, and it is kept for the case where one
# does not: an applet found by table lookup is correct, while one that has to be
# found by PATH is one more thing that can go wrong in a system this small.
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_INSTALL_APPLET_SYMLINKS=n

# ---------------------------------------------------------------------------
# The shell.
#
# ash, because it is the smallest of busybox's shells that is a real shell. The
# line editor and the history file are part of ash itself rather than a separate
# library, which is the reason it is a megabyte of program and hush is not
# smaller by enough to matter.
# ---------------------------------------------------------------------------
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_SHELL_ASH=y
CONFIG_BASH_IS_NONE=y

# Run an applet out of the shell's own builtin slot rather than forking it. This
# is most of what makes a busybox shell feel fast, and it costs one comparison
# per command.
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y

# Job control. Not speculative: the pty layer implements process groups, setsid
# and TIOCSPGRP, and without this the shell would be unable to use what it has.
CONFIG_ASH_JOB_CONTROL=y
CONFIG_CTTYHACK=y

# $((...)) arithmetic, in 64 bits. The shell is where arithmetic happens on a
# system with no bc and no compiler.
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_FEATURE_SH_MATH_BASE=y

# ash builtins. Each is a case where the shell answering directly is both smaller
# and faster than forking an applet: `echo` is a write, `test` is a branch, and
# `printf` is a format call. ASH_CMDCMD is the `command` keyword, which is how a
# script says "this is the program, not a builtin" and is also what ash's
# standalone-lookup needs in order to be able to find it.
CONFIG_ASH_ALIAS=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y

# $RANDOM. Two lines of state, and a script that seeds a name or picks a delay
# wants it.
CONFIG_ASH_RANDOM_SUPPORT=y

# Interactive prompt expansion. Without it the prompt cannot show the current
# directory, which is the one thing a prompt is for.
CONFIG_ASH_EXPAND_PRMT=y

# Keep history between shells. ash's own mechanism; the size limit is what stops
# an unbounded file on a filesystem with no quota.
CONFIG_FEATURE_SH_HISTFILESIZE=y

# Hide the "can't find command" chatter on an interactive shell, so that a
# mistyped command does not scroll away what the user was reading.
CONFIG_FEATURE_SH_EXTRA_QUIET=y

# ---------------------------------------------------------------------------
# Global features.
# ---------------------------------------------------------------------------
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_VERBOSE=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_FEATURE_TIMEZONE=y

