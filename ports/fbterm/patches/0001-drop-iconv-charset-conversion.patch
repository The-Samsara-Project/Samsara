+/*
+ * Samsara: no iconv, so no charset conversion.
+ *
+ * Upstream opens an iconv descriptor pair here to convert between the terminal's
+ * UTF-8 and whatever encoding the user selected. Samsara's libc has no iconv,
+ * and adding it would mean porting a character-set database to get a feature
+ * that has no use here: the port is UTF-8 end to end, and the encoding fbterm
+ * asks about (IoPipe::localCodec) already resolves to "UTF-8" on a system with
+ * no locales.
+ *
+ * So the only case that needs no conversion -- UTF-8 on both sides -- is
+ * honoured, and it is handled by leaving the codec descriptors null, which is
+ * the existing pass-through path in ready() below. A request for any other pair
+ * is refused out loud rather than silently ignored, because a program that asked
+ * for a conversion and quietly got none would draw mojibake with no indication
+ * of why.
+ */
+static bool codecIsUtf8(const s8 *name)
+{
+	return name && (!strcasecmp(name, "UTF-8") || !strcasecmp(name, "UTF8"));
+}
+
