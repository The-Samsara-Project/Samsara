diff --git a/src/lib/shell.cpp b/src/lib/shell.cpp
index 0dfdef7..09a2173 100644
--- a/src/lib/shell.cpp
+++ b/src/lib/shell.cpp
@@ -31,6 +31,7 @@
 #include <sys/ioctl.h>
 #include <sys/wait.h>
 #include "shell.h"
+#include "../fbconfig.h"
 
 void waitChildProcessExit(s32 pid)
 {
@@ -71,6 +72,28 @@ Shell::~Shell()
 
 void Shell::createShellProcess(s8 **command)
 {
+	/*
+	 * Samsara: attach to a terminal somebody else owns, when told to.
+	 *
+	 * forkpty() below makes this process the parent of the shell, and a
+	 * child inherits its parent's identity. On Samsara that makes the
+	 * login program a uid 1000 program, and a getty that cannot setuid(0)
+	 * refuses every root login -- after accepting the password, so the
+	 * screen says only "could not set up the session" and nothing points
+	 * at the cause.
+	 *
+	 * The privileged program is started by the kernel instead, which seeds
+	 * it as root because that is what a getty is, and passes the terminal
+	 * in with --attach-fd. fbterm draws it and starts nothing.
+	 */
+	s32 attach = Config::instance()->getAttachFd();
+	if (attach >= 0) {
+		setFd(attach);
+		setCodec("UTF-8", localCodec());
+		resize(w(), h());
+		return;
+	}
+
 	s32 fd;
 	mPid = forkpty(&fd, NULL, NULL, NULL);
 
