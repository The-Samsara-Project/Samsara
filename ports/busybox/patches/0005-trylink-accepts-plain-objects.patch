 	$debug && echo "Trying -l options: '$l_list'"
 	try $CC $CFLAGS $LDFLAGS \
@@ -166,7 +206,7 @@ while test "$LDLIBS"; do
 		$SORT_COMMON \
 		$SORT_SECTION \
 		$GC_SECTIONS \
-		$START_GROUP $O_FILES $A_FILES $END_GROUP \
+		$START_GROUP $l_objs $O_FILES $A_FILES $END_GROUP \
 		$l_list
 	if test $? = 0; then
 	    echo " Library $one is not needed, excluding it"
@@ -186,7 +226,8 @@ done
 
